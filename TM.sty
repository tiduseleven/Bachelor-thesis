% Category-theoretical usefuls
\newcommand{\cat}[1]{\mathcal{#1}}
\newcommand{\oset}[2]{%
  {\mathop{#2}\limits^{\vbox to -.5\ex@{\kern-\tw@\ex@
   \hbox{\scriptsize #1}\vss}}}}

%\newcommand{\oset}[2]{%
%  {\mathop{#2}\limits^{\vbox{\kern-.7ex\hbox{$\scriptstyle #1$}}}}}

\newcommand{\red}[1]{\textcolor{red}{#1}}
\newcommand{\green}[1]{\textcolor{green}{#1}}
\newcommand{\blue}[1]{\textcolor{blue}{#1}}
\newcommand{\orange}[1]{\textcolor{orange}{#1}}
\newcommand{\ses}[5]{#1\xrightarrow{#4}#2\xrightarrow{#5}#3}
\newcommand{\op}{^{\textnormal{op}}}
\newcommand{\xra}[1]{\xrightarrow{#1}}
\newcommand{\xrat}[1]{\ \oset{$#1$}{\rightarrowtail}\ }
\newcommand{\xratshit}[1]{\overset{#1}{\rightarrowtail}}
\newcommand{\xrath}[1]{\ \oset{$#1$}{\twoheadrightarrow}\ }
\newcommand{\xrathshit}[1]{\overset{#1}{\twoheadrightarrow}}
\newcommand{\Img}[1]{\textnormal{Im }#1}
\newcommand{\Ker}[1]{\textnormal{Ker }#1}
\newcommand{\Cok}[1]{\textnormal{Cok }#1}
\newcommand{\cok}[1]{\textnormal{cok}#1}
\newcommand{\Coim}[1]{\textnormal{Coim }#1}
\newcommand{\Ch}[1]{\Chlen{}{#1}}
\newcommand{\Hcat}[1]{\textnormal{H}\left(#1\right)}
\newcommand{\Chlen}[2]{\textnormal{Ch}^{#1}\left(#2\right)}
\newcommand{\C}[1]{C\left(#1\right)}

\newcommand{\pullback}[3]{
  % https://q.uiver.app/#
\[\begin{tikzcd}[ampersand replacement=\&, sep=small]
	{#1'} \&\& {#2'} \\
	\& {\text{PB}} \\
	#1 \&\& #2
	\arrow["{#3'}", shorten <=5pt, shorten >=5pt, from=1-1, to=1-3]
	\arrow["\lowercase{#1}"', shorten <=3pt, shorten >=3pt, from=1-1, to=3-1]
	\arrow["\lowercase{#2}", shorten <=3pt, shorten >=3pt, from=1-3, to=3-3]
	\arrow["#3"', shorten <=5pt, shorten >=5pt, from=3-1, to=3-3]
\end{tikzcd}\]
}

